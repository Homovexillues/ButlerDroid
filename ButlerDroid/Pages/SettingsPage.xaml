<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ButlerDroid.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="设置"
    BackgroundColor="#F6F7F9">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="通知和后台" FontSize="20" FontAttributes="Bold" />

            <Border
                Padding="14"
                Stroke="#E4E7EB"
                StrokeThickness="1"
                BackgroundColor="White">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="语音播报" FontAttributes="Bold" />
                        <Label Text="提醒触发后用 Android 系统 TTS 朗读正文。" FontSize="12" TextColor="#777" />
                    </VerticalStackLayout>
                    <Switch x:Name="SpeechSwitch" Grid.Column="1" Toggled="OnSpeechToggled" />
                </Grid>
            </Border>

            <Button
                Text="重新运行权限引导"
                BackgroundColor="#00796B"
                TextColor="White"
                Clicked="OnRunPermissionFlow" />
            <Button
                Text="启动调度服务"
                BackgroundColor="#00796B"
                TextColor="White"
                Clicked="OnStartService" />
            <Button
                Text="停止调度服务"
                BackgroundColor="#E53935"
                TextColor="White"
                Clicked="OnStopService" />

            <Label x:Name="StatusLabel" Text="" TextColor="#555" />

            <BoxView HeightRequest="1" Color="#DDD" Margin="0,8" />

            <Label Text="安卓后台说明" FontSize="14" FontAttributes="Bold" />
            <Label
                Text="应用使用精确闹钟和前台服务保持本地提醒。用户手动强行停止应用、或厂商系统限制后台运行时，提醒仍可能失效。"
                FontSize="12"
                TextColor="#777" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
